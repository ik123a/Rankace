# Copy to .env and supply a generated secret before starting Rankace.
# Example generator: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Local backend. Compose supplies its own PostgreSQL DATABASE_URL.
DATABASE_URL=sqlite:///./data/rankace.db
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_SECONDS=15
CRAWL_USER_AGENT=RankaceBot/1.0
CRAWL_DELAY_SECONDS=0.5

# Compose only. Use a separate URL-safe generated password, such as secrets.token_urlsafe(32).
POSTGRES_PASSWORD=
APP_BIND_ADDRESS=127.0.0.1

# Browser-facing URL. For local Next.js development set this in frontend/.env.local if changed.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The public synthetic dashboard uses no account. A local sign-in account is opt-in.
DEMO_ENABLED=false
DEMO_EMAIL=demo@rankace.local
DEMO_PASSWORD=
