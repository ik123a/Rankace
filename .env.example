# Rankace — environment template
# Copy to .env and fill in. Never commit real secrets.

# --- Backend ---
DATABASE_URL=sqlite:///./data/rankace.db
# For Postgres: postgresql+psycopg://rankace:rankace@db:5432/rankace
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Both loopback spellings and every port this project is served on.
# `localhost` and `127.0.0.1` are different origins to a browser, so one does
# not cover the other -- omitting either blocks all /api calls from the app.
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://127.0.0.1:3000,http://127.0.0.1:3100

API_HOST=0.0.0.0
API_PORT=8000

# --- Crawler ---
CRAWL_MAX_PAGES=50
CRAWL_MAX_DEPTH=3
CRAWL_TIMEOUT_SECONDS=15
CRAWL_USER_AGENT=RankaceBot/1.0 (+https://rankace.local/bot)
CRAWL_RESPECT_ROBOTS=true
CRAWL_DELAY_SECONDS=0.5

# --- NLP / ML (optional, graceful fallback if not installed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
ENABLE_ML=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Demo ---
DEMO_EMAIL=demo@rankace.local
DEMO_PASSWORD=demo1234
